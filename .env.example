# Database (Neon Postgres — https://neon.tech, free tier is plenty to start)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Admin dashboard password (single operator login — this is you)
ADMIN_PASSWORD=change-me
# Random secret used to sign admin/staff session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public URL of this app — used to build tap links and QR codes.
# Production is https://meetcompass.io (see render.yaml).
#
# Whatever this is set to gets written onto physical NFC tags, hostname and
# all, so treat a change to it in production as permanent: tags already in the
# field keep pointing at the old hostname and cannot be rewritten remotely.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio (SMS) — leave unset to log messages to the console instead of sending
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Platform-wide fallback "from" number. Each business can override this with
# its own number in the admin dashboard once you've bought one per business.
TWILIO_DEFAULT_FROM_NUMBER=

# Resend (email) — leave unset to log emails to the console instead of sending
RESEND_API_KEY=
RESEND_FROM_EMAIL=
